# This file contains only non-secret examples. Copy it outside Git for a real host:
#   sudo install -d -m 700 /etc/toptrainers
#   sudo cp .env.example /etc/toptrainers/prod.env
#   sudo chmod 600 /etc/toptrainers/prod.env

# Deployment target. 100.90.138.119 is a tailnet/CGNAT address, not a public DNS target.
TT_SERVER_IP=100.90.138.119
TT_EDGE_PORT=8080
TT_PUBLIC_DOMAIN=toptrainers.localhost

# FastAPI runtime
TT_ENVIRONMENT=development
TT_LOG_LEVEL=INFO
TT_ALLOWED_HOSTS=localhost,127.0.0.1,testserver,app.toptrainers.localhost,toptrainers.localhost,*.toptrainers.localhost
TT_CORS_ORIGINS=http://app.toptrainers.localhost:8080,http://toptrainers.localhost:8080
TT_DATABASE_URL=postgresql+asyncpg://toptrainers:change-me@postgres:5432/toptrainers
TT_REDIS_URL=redis://redis:6379/0
TT_JWT_SIGNING_KEY=replace-with-a-long-random-secret-before-production
TT_OPENAPI_ENABLED=true

# PostgreSQL container (do not reuse these values in production)
POSTGRES_DB=toptrainers
POSTGRES_USER=toptrainers
POSTGRES_PASSWORD=change-me

# Managed S3 is preferred in production. Leave empty until media is implemented.
TT_S3_ENDPOINT_URL=
TT_S3_BUCKET=
TT_S3_REGION=ru-1
TT_S3_ACCESS_KEY_ID=
TT_S3_SECRET_ACCESS_KEY=
