[Unit]
Description=Deploy TopTrainers from the reviewed GitHub main branch
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
Environment="GIT_SSH_COMMAND=/usr/bin/ssh -i /etc/toptrainers/github-deploy-key -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new"
ExecStart=/usr/local/sbin/toptrainers-deploy
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
